#!/usr/bin/env bash
# boardctl -- declare and control this machine's boards.
#
#     boardctl add <name> --repo <path> [--key-file <path>] [--priority N]
#     boardctl remove <name>
#     boardctl list
#     boardctl status <name>
#     boardctl halt <name>
#     boardctl resume <name>
#     boardctl cleanup <name>
#
# A board is ONE declared fact: the local path of the repository it builds.
# boardctl is the only writer of $FOREMAN_HOME/boards.toml; bin/boards.py
# (see that file) only ever reads it. The Linear team, the project, and every
# resolved state and label id come from the target repository's own
# board.toml and from Linear itself -- read fresh by config.sh and
# bin/resolve-ids.py, never written by boardctl. This used to build a whole
# instance directory per board (instance.env, a copy of the Linear key,
# resolved ids); now `add` and `remove` touch one file.
#
# $FOREMAN_HOME/instances/<name>/ still exists, as the per-board RUNTIME
# directory (cards/, ids.env, HALT). boardctl touches only HALT there.
# `add` never creates it and `remove` never deletes it, so removing a board's
# declaration never costs an operator its card history by accident -- that is
# a separate, deliberate act.
set -euo pipefail

here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
root="$(dirname -- "$here")"
boards_py="$root/bin/boards.py"
installation_py="$root/bin/installation.py"

die() { printf 'boardctl: %s\n' "$*" >&2; exit 1; }

# bin/load-pairs.sh is the shared reader of the NUL-separated KEY, VALUE pairs
# bin/installation.py and bin/boards.py emit; its comment carries the bash 3.2
# measurement behind the temp file it reads through.
. "$root/bin/load-pairs.sh" || die "cannot read $root/bin/load-pairs.sh"

# load_foreman_home -- sets and exports FOREMAN_HOME as bin/installation.py
# derives it, which is the parent of this clone unless the environment says
# otherwise.
#
# ONE FACT, ONE PLACE. An explicit FOREMAN_HOME wins, so a test can point a
# whole foreman at a temporary directory; otherwise the home is the clone's
# parent. Deriving it a second time here would agree with installation.py only
# until one of them was edited.
load_foreman_home() {
  # Only the home is wanted here, and the reader lets the environment win for
  # every key it reads, so the rest are cleared first: boardctl must never take
  # an INSTALLATION or a HARNESS from a stray export in an operator's shell.
  # FOREMAN_HOME itself is left alone -- installation.py reads it to find the
  # home to answer for, and clearing it would point this at another one.
  unset INSTALLATION IS_DEFAULT HARNESS FOREMAN_ROOT
  # installation.py has already named what it could not make sense of.
  _foreman_load_pairs "foreman's declaration" "$installation_py" \
    || die "bin/installation.py refused; cannot tell which home this clone belongs to"

  [[ -n "${FOREMAN_HOME:-}" ]] || die "bin/installation.py emitted no FOREMAN_HOME"
  export FOREMAN_HOME
}

load_foreman_home
boards_toml="$FOREMAN_HOME/boards.toml"

usage() {
  cat >&2 <<'USAGE'
usage:
  boardctl add <name> --repo <path> [--key-file <path>] [--priority N]
  boardctl remove <name>
  boardctl list
  boardctl status <name>
  boardctl halt <name>
  boardctl resume <name>
  boardctl cleanup <name>
USAGE
  exit 2
}

instance_home() { printf '%s/instances/%s\n' "$FOREMAN_HOME" "$1"; }

# Same constraint bin/boards.py and config.sh both enforce on a board name --
# see boards.py's own comment for the failure this prevents: an unconstrained
# name lets one board's worktree glob absorb another's, because
# worktree_path and sweep.sh's glob join the name and a ticket with a hyphen.
validate_name() {
  local name="$1"
  [[ "$name" =~ ^[A-Za-z0-9_]+$ ]] || \
    die "board name '$name' is invalid; only letters, digits and underscore are allowed (no hyphen, no slash)"
}

# toml_string <value> -- <value> as a TOML basic string. Paths are the only
# values boardctl ever writes, so escaping backslash and double-quote is
# every case that can occur.
toml_string() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '"%s"' "$s"
}

# boards_py_call <args...> -- runs bin/boards.py, leaves its NUL-separated
# stdout in a temp file named by $reply, and dies on its stderr if it failed.
#
# A temp file, not $(...): bash 3.2 silently drops NUL bytes inside command
# substitution (measured; see bin/load-pairs.sh's own comment), which
# would make every field boards.py emits come back empty rather than fail
# loudly.
boards_py_call() {
  local out err
  out="$(mktemp)"; err="$(mktemp)"
  if ! "$boards_py" "$@" >"$out" 2>"$err"; then
    local msg; msg="$(cat "$err")"
    rm -f "$out" "$err"
    die "$msg"
  fi
  rm -f "$err"
  reply="$out"
}

# nul_fields <file> -- reads a boards_py_call output file into the global
# array `fields`, then removes the file. `read -d ''` on a NUL-terminated
# stream, since this project's bash 3.2 floor has no `mapfile`.
nul_fields() {
  fields=()
  local field
  while IFS= read -r -d '' field; do
    fields+=("$field")
  done <"$1"
  rm -f "$1"
}

# board_names -- every board bin/boards.py knows about, or an empty list if
# boards.toml does not exist yet.
board_names() {
  fields=()
  [[ -f "$boards_toml" ]] || return 0
  boards_py_call --list
  nul_fields "$reply"
}

# raw_board_declared <name> -- true if boards.toml's raw text already has a
# [boards.<name>] header. A text check, not bin/boards.py, on purpose: add's
# and remove's "does this name exist" question must still get a real answer
# even when boards.toml currently fails to load for a reason that has
# nothing to do with <name> -- a different board's repo that got deleted out
# from under it, say. Whether the WRITE that follows is safe is a separate
# question, answered by revert_unless_valid against the file that write
# actually produces.
raw_board_declared() {
  local name="$1"
  [[ -f "$boards_toml" ]] || return 1
  grep -qxF "[boards.$name]" "$boards_toml"
}

# board_repo <name> -- REPO for a declared board, or dies naming it unknown.
# Used by status/halt/resume, none of which write boards.toml, to confirm the
# board is declared before touching its runtime directory.
board_repo() {
  local name="$1"
  boards_py_call "$name"
  nul_fields "$reply"
  # fields = REPO, <repo>, KEY_FILE, <key_file> -- see bin/boards.py's emit().
  [[ ${#fields[@]} -ge 2 ]] || die "bin/boards.py returned no REPO for '$name'"
  printf '%s' "${fields[1]}"
}

# revert_unless_valid <tmp> <fail-message> -- if bin/boards.py cannot load
# <tmp>, deletes it and dies with <fail-message> plus boards.py's own error.
# The ORIGINAL boards.toml is never touched until this passes, and nothing
# here ever leaves a bad <tmp> where a later read could find it -- a
# boards.toml that does not parse breaks EVERY board on the machine, not just
# the one whose write triggered this.
revert_unless_valid() {
  local tmp="$1" message="$2" err_out
  if ! err_out="$("$boards_py" --file "$tmp" --list 2>&1 >/dev/null)"; then
    rm -f "$tmp"
    die "$message: $err_out"
  fi
}

# new_tmp -- a temp file next to boards.toml, so the final `mv` is a rename on
# one filesystem rather than a copy across two.
new_tmp() {
  mkdir -p "$FOREMAN_HOME"
  mktemp "$boards_toml.XXXXXX"
}

# priority_lines <priority> -- the lines `add` writes into a new board's table
# for its priority. <priority> is what the operator passed to --priority, or
# empty when they passed nothing. Writing no line reads as bin/boards.py's
# DEFAULT_PRIORITY, so a boards.toml written before priorities existed divides
# exactly as it always did.
priority_lines() {
  local priority="$1"
  if [[ -n "$priority" ]]; then
    printf 'priority = %s\n' "$priority"
  fi
}

cmd_add() {
  [[ $# -ge 1 ]] || usage
  local name="$1"; shift
  validate_name "$name"

  local repo="" key_file="" priority=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)
        [[ $# -ge 2 ]] || die "add: --repo needs a value"
        repo="$2"; shift 2 ;;
      --key-file)
        [[ $# -ge 2 ]] || die "add: --key-file needs a value"
        key_file="$2"; shift 2 ;;
      --priority)
        [[ $# -ge 2 ]] || die "add: --priority needs a value"
        priority="$2"; shift 2 ;;
      *) die "add: unrecognized argument '$1'" ;;
    esac
  done
  [[ -n "$repo" ]] || die "add: --repo is required"
  # A non-negative integer, as bin/boards.py requires, spelled the way TOML
  # spells one: `007` is not a TOML integer. Refused here so the message names
  # the flag; revert_unless_valid still asks boards.py about the whole file.
  if [[ -n "$priority" && ! "$priority" =~ ^(0|[1-9][0-9]*)$ ]]; then
    die "add: --priority must be a non-negative integer, got '$priority'"
  fi

  [[ -d "$repo" ]] || die "no such repository directory: $repo"
  repo="$(cd -- "$repo" && pwd)"
  [[ -f "$repo/board.toml" ]] || \
    die "$repo has no board.toml -- not a foreman target"

  if [[ -n "$key_file" ]]; then
    [[ -f "$key_file" ]] || die "no such linear key file: $key_file"
    key_file="$(cd -- "$(dirname -- "$key_file")" && pwd)/$(basename -- "$key_file")"
  fi

  raw_board_declared "$name" && \
    die "board '$name' already exists in $boards_toml"

  local tmp; tmp="$(new_tmp)"
  [[ -f "$boards_toml" ]] && cat "$boards_toml" >"$tmp"
  {
    [[ -s "$tmp" ]] && printf '\n'
    printf '[boards.%s]\n' "$name"
    printf 'repo = %s\n' "$(toml_string "$repo")"
    [[ -n "$key_file" ]] && printf 'key = %s\n' "$(toml_string "$key_file")"
    priority_lines "$priority"
  } >>"$tmp"

  revert_unless_valid "$tmp" \
    "boards.toml would not parse after adding '$name'; nothing written"
  mv -f "$tmp" "$boards_toml"

  printf 'boardctl: board %s added, serving %s\n' "$name" "$repo"
}

cmd_remove() {
  [[ $# -eq 1 ]] || usage
  local name="$1"
  raw_board_declared "$name" || die "no board named '$name' in $boards_toml"

  local tmp; tmp="$(new_tmp)"
  # Removes the block from "[boards.$name]" up to (not including) the next
  # "[...]" header or end of file. Safe because boardctl is the only writer
  # of this file and never emits anything inside a board's table but plain
  # KEY = VALUE lines and the `#` comment `add` writes above a priority --
  # there is no nested table to mistake for the next board's header.
  awk -v header="[boards.$name]" '
    $0 == header { skip = 1; next }
    skip && /^\[/ { skip = 0 }
    skip { next }
    { print }
  ' "$boards_toml" >"$tmp"

  revert_unless_valid "$tmp" \
    "removing '$name' would leave boards.toml unparseable; nothing written"
  mv -f "$tmp" "$boards_toml"

  local inst; inst="$(instance_home "$name")"
  printf 'boardctl: board %s removed from %s\n' "$name" "$boards_toml"
  printf 'boardctl: its runtime directory is untouched at %s\n' "$inst"
}

cmd_list() {
  board_names
  local name
  for name in ${fields[@]+"${fields[@]}"}; do
    printf '%s\t%s\n' "$name" "$(board_repo "$name")"
  done | sort
}

cmd_status() {
  [[ $# -eq 1 ]] || usage
  local name="$1"
  local repo; repo="$(board_repo "$name")"
  local inst; inst="$(instance_home "$name")"

  local ids_state="not resolved"
  [[ -f "$inst/ids.env" ]] && ids_state="resolved"
  local halt_state="running"
  [[ -f "$inst/HALT" ]] && halt_state="halted"

  printf 'board: %s\n' "$name"
  printf 'repo:  %s\n' "$repo"
  printf 'ids:   %s\n' "$ids_state"
  printf 'state: %s\n' "$halt_state"
}

cmd_halt() {
  [[ $# -eq 1 ]] || usage
  local name="$1"
  board_repo "$name" >/dev/null
  # mkdir, not a plain touch: `add` never creates the runtime directory, so
  # halting a board before its first tick must still be able to place HALT
  # where that first tick will look for it.
  local inst; inst="$(instance_home "$name")"
  mkdir -p "$inst"
  : > "$inst/HALT"
  printf 'boardctl: board %s halted\n' "$name"
}

cmd_resume() {
  [[ $# -eq 1 ]] || usage
  local name="$1"
  board_repo "$name" >/dev/null
  local inst; inst="$(instance_home "$name")"
  rm -f "$inst/HALT"
  printf 'boardctl: board %s resumed\n' "$name"
}

# cmd_cleanup <name> -- deletes instances/<name>/last-cleanup, so the next
# slice finds the board due. skills/board/reconcile.py writes and reads this
# same literal path (see its own comment); a stamp file two files spell
# differently is a cleanup that never comes due, or one that never stops,
# exactly the failure HALT's shared path already avoids.
cmd_cleanup() {
  [[ $# -eq 1 ]] || usage
  local name="$1"
  board_repo "$name" >/dev/null
  local inst; inst="$(instance_home "$name")"
  rm -f "$inst/last-cleanup"
  printf 'boardctl: cleanup for %s is due on its next slice\n' "$name"
}

[[ $# -ge 1 ]] || usage
cmd="$1"; shift
case "$cmd" in
  add) cmd_add "$@" ;;
  remove) cmd_remove "$@" ;;
  list) cmd_list "$@" ;;
  status) cmd_status "$@" ;;
  halt) cmd_halt "$@" ;;
  resume) cmd_resume "$@" ;;
  cleanup) cmd_cleanup "$@" ;;
  *) usage ;;
esac
